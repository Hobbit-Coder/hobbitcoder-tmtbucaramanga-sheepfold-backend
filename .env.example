# Sheepfold Backend (sheepfold-api) - plantilla sin secretos (copiar como .env y completar)
# Formato de Dokploy (Environment): una variable por línea. "#" inicia un comentario, así que todo valor que
# contenga "#" va entre comillas dobles. Las secciones de .NET se separan con "__" (Messaging__Evolution__Url).
# Lo que no está aquí viene de appsettings.Production.json. Guía: docs/requerimiento/despliegue-dokploy.md.

# Base de datos (Sheepfold Database > General > Internal Credentials)
ConnectionStrings__Default="Host=<host-interno-sheepfold-db>;Port=5432;Database=Sheepfold;Username=postgres;Password=<contraseña>"

# Directorio de cuentas en Identity (mismo secreto que Jwt__ServiceClients__0__Secret de Identity)
IdentityDirectory__ClientSecret=<secreto de 32+ caracteres>

# Archivos: Contabo Object Storage (claves en Dokploy > S3 Destinations > TMT Bucaramanga)
Storage__ServiceUrl=https://usc1.contabostorage.com
Storage__Region=US-central
Storage__Bucket=tmt-bucaramanga-sheepfold
Storage__ForcePathStyle=true
Storage__AccessKey=<access key>
Storage__SecretKey="<secret key>"

# WhatsApp con Evolution API (docs/requerimiento/whatsapp-evolution.md)
Messaging__Evolution__Url=https://evolution.tmtbucaramanga.com
Messaging__Evolution__Instance=sheepfold
Messaging__Evolution__ApiKey="<token de la instancia>"
