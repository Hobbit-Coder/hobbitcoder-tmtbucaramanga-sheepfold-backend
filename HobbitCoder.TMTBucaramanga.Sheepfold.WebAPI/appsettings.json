{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Persistence": {
    "Provider": "PostgreSQL"
  },
  "CorsSettings": {
    "AllowedOrigins": [],
    "AllowedMethods": [
      "GET",
      "POST",
      "PUT",
      "PATCH",
      "DELETE"
    ],
    "AllowedHeaders": [
      "Authorization",
      "Content-Type"
    ],
    "ExposedHeaders": [
      "Location",
      "WWW-Authenticate"
    ],
    "AllowCredentials": false,
    "MaxAgeInSeconds": 600
  },
  "JwtSettings": {
    "Authority": "",
    "Audience": "HobbitCoder.TMTBucaramanga.Sheepfold"
  },
  "IdentityDirectory": {
    "BaseUrl": "",
    "ClientId": "sheepfold-api",
    "CacheSeconds": 60
  },
  "Storage": {
    "ServiceUrl": "",
    "Region": "",
    "Bucket": "",
    "ForcePathStyle": true,
    "MaxUploadBytes": 30000000
  },
  "Messaging": {
    "BaseUrl": "https://graph.facebook.com",
    "ApiVersion": "v24.0",
    "PhoneNumberId": "",
    "NotificationTemplate": "tmt_aviso",
    "TemplateLanguage": "es",
    "TimeoutSeconds": 10
  },
  "Notifications": {
    "ScheduleIntervalMinutes": 60
  }
}