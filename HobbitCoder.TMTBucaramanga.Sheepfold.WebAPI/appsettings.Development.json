{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Persistence": {
    "Provider": "PostgreSQL"
  },
  "CorsSettings": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ],
    "AllowedMethods": [
      "GET",
      "POST",
      "PUT",
      "PATCH",
      "DELETE"
    ],
    "AllowedHeaders": [
      "Authorization",
      "Content-Type"
    ],
    "ExposedHeaders": [
      "Location",
      "WWW-Authenticate"
    ],
    "AllowCredentials": false,
    "MaxAgeInSeconds": 600
  },
  "JwtSettings": {
    "Authority": "https://localhost:7101",
    "Audience": "HobbitCoder.TMTBucaramanga.Sheepfold"
  }
}
